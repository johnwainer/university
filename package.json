{
  "name": "pae-u",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pae-u/api & npm run dev -w @pae-u/web",
