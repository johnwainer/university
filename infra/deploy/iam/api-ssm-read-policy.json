{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPlataformaEstudiantilEnvParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:467590374794:parameter/plataforma-estudiantil/production",
        "arn:aws:ssm:us-east-1:467590374794:parameter/plataforma-estudiantil/production/*"
      ]
    },
    {
      "Sid": "DecryptSecureStringsViaSsmOnly",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.us-east-1.amazonaws.com"
        }
      }
    }
  ]
}
