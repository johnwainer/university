{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManagePlataformaEstudiantilParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:AddTagsToResource",
        "ssm:DeleteParameter",
        "ssm:DeleteParameters",
        "ssm:DescribeParameters",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:LabelParameterVersion"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:467590374794:parameter/plataforma-estudiantil",
        "arn:aws:ssm:us-east-1:467590374794:parameter/plataforma-estudiantil/*"
      ]
    },
    {
      "Sid": "EncryptAndDecryptViaSsmOnly",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.us-east-1.amazonaws.com"
        }
      }
    }
  ]
}
