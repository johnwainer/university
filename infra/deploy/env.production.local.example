# env.production.local.example
#
# Template for the file 50-secrets-put.sh reads. Copy it, fill it in, upload it
# to SSM, then shred it:
#
#   cp env.production.local.example env.production.local
#   chmod 600 env.production.local
#   $EDITOR env.production.local
#   ./50-secrets-put.sh --file env.production.local
#   shred -u env.production.local
#
# 'env.production.local' matches infra/deploy/.gitignore, so it is never
# committed. This .example file holds placeholders only - no real values here.
#
# Every line becomes one SecureString at
#   /plataforma-estudiantil/production/env/<KEY>
# and 10-api-bootstrap.sh renders the whole prefix into the instance's .env.
# To add a variable, add a line here and re-run 50-secrets-put.sh - nothing
# else enumerates the key list.

# --- server ----------------------------------------------------------------
# 127.0.0.1, not 0.0.0.0: nginx is the only thing that may reach the API.
HOST=127.0.0.1
PORT=4000

# --- admin console ---------------------------------------------------------
# ADMIN_API_KEY is a machine-to-machine shared secret accepted in the
# x-admin-key header. ADMIN_EMAIL/ADMIN_PASSWORD are the credentials
# POST /api/admin/auth/login checks, and the ones 90-smoke-test.sh uses.
# Generate the key with: openssl rand -hex 32
ADMIN_API_KEY=<openssl rand -hex 32>
ADMIN_EMAIL=<admin@thefloridianuniversity.com>
ADMIN_PASSWORD=<a long random password>
ADMIN_SESSION_TTL_MINUTES=720

# --- sync cadence ----------------------------------------------------------
AUTO_SYNC_INTERVAL_SEC=180
PUBLIC_SYNC_MAX_AGE_SEC=30
PUBLIC_SESSION_TTL_MINUTES=43200

# --- database --------------------------------------------------------------
# Built for you by: ./40-db-init.sh --put-ssm
# Shape: postgresql://paeu_app:<url-encoded-password>@<endpoint>:5432/paeu?sslmode=require
# The endpoint hostname is NOT recorded in this repository - take it from the
# Lightsail console (Databases > plataforma-estudiantil-postgres > Connect).
DATABASE_URL=<see 40-db-init.sh --put-ssm>

# --- Moodle ----------------------------------------------------------------
# MOODLE_TOKEN comes from ./21-moodle-webservices.sh (run on the Moodle host).
MOODLE_BASE_URL=https://lms.portal.thefloridianuniversity.com
MOODLE_TOKEN=<token printed by 21-moodle-webservices.sh>

# --- identidad institucional ------------------------------------------------
# El API usa INSTITUTION_NAME en el checklist CIE (etiqueta de la unidad
# institucional), en las plantillas de syllabus y en el reporte IPEDS. El
# default committeado en .env.example pertenece al entorno de desarrollo de la
# rama; el despliegue real lo fija aqui, que es la fuente de verdad en SSM.
INSTITUTION_NAME=The Floridian University

# --- external integration (api.pasosalexito.com) ---------------------------
EXTERNAL_INTEGRATION_BASE_URL=https://api.pasosalexito.com
EXTERNAL_INTEGRATION_API_KEY=<integration api key>

# --- variables another engineer is adding ----------------------------------
# Contact-form notification and compliance settings land here. Add them as
# plain KEY=VALUE lines; no script needs changing.
# CONTACT_NOTIFICATION_EMAIL=<...>
# SMTP_HOST=<...>
