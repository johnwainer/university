# lms-https-vhost.conf.template
#   -> /opt/bitnami/apache/conf/vhosts/paeu-lms-https-vhost.conf
#
# HTTPS vhost for Moodle on the Bitnami LAMP stack.
#
# Contract constraint (Etapa I): no frontend may consume Moodle directly - only
# the Fastify API is allowed to. That is enforced here by allow-listing
# /webservice/ to the API instance's static IP (plus loopback). Admins keep full
# access to /login and the web UI.
#
# Placeholders substituted by 20-moodle-install.sh:
#   __LMS_HOST__ __MOODLE_DIR__ __ACME_WEBROOT__ __TLS_CERT__ __TLS_KEY__
#   __TLS_CHAIN__ __WS_ALLOW_DIRECTIVES__

<VirtualHost *:443>
  ServerName __LMS_HOST__
  DocumentRoot "__MOODLE_DIR__"

  ServerSignature Off

  SSLEngine on
  SSLCertificateFile      "__TLS_CERT__"
  SSLCertificateKeyFile   "__TLS_KEY__"
  SSLCertificateChainFile "__TLS_CHAIN__"

  SSLProtocol             -all +TLSv1.2 +TLSv1.3
  SSLHonorCipherOrder     off
  SSLCipherSuite          ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
  SSLSessionTickets       off
  SSLUseStapling          on

  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options    "nosniff"
  Header always set Referrer-Policy           "strict-origin-when-cross-origin"
  # Moodle itself sends a frame policy for its own embeds; do not force DENY
  # globally or the course player and the mobile app break.
  Header always unset X-Powered-By
  Header always unset X-AspNet-Version

  Alias /.well-known/acme-challenge/ "__ACME_WEBROOT__/.well-known/acme-challenge/"
  <Directory "__ACME_WEBROOT__/.well-known/acme-challenge">
    Options None
    AllowOverride None
    Require all granted
    ForceType text/plain
  </Directory>

  <Directory "__MOODLE_DIR__">
    Options -Indexes +FollowSymLinks
    AllowOverride All
    Require all granted
    DirectoryIndex index.php index.html
  </Directory>

  # moodledata lives outside DocumentRoot, but belt and braces: never serve it.
  <DirectoryMatch "__MOODLE_DIR__/(\.git|vendor|node_modules)">
    Require all denied
  </DirectoryMatch>

  # Moodle's own hardening recommendation: block direct execution of the
  # bundled CLI/internal scripts over HTTP.
  <LocationMatch "^/(admin/cli|lib/classes|install/)">
    Require all denied
  </LocationMatch>
  <Location "/admin/cli">
    Require all denied
  </Location>

  # --- Web service surface: API-only -----------------------------------------
  # __WS_ALLOW_DIRECTIVES__ is generated from MOODLE_WS_ALLOW_IPS. When
  # MOODLE_RESTRICT_WEBSERVICE=0 the generated block is "Require all granted".
  <Location "/webservice">
    __WS_ALLOW_DIRECTIVES__
  </Location>

  ErrorLog  "/opt/bitnami/apache/logs/__LMS_HOST__-error_log"
  CustomLog "/opt/bitnami/apache/logs/__LMS_HOST__-access_log" combined
</VirtualHost>
