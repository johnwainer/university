HOST=0.0.0.0
PORT=4000
ADMIN_API_KEY=dev-admin-key
ADMIN_EMAIL=admin@atlas.local
ADMIN_PASSWORD=AtlasAdmin!2026
ADMIN_SESSION_TTL_MINUTES=720
AUTO_SYNC_INTERVAL_SEC=180
PUBLIC_SYNC_MAX_AGE_SEC=30
PUBLIC_SESSION_TTL_MINUTES=43200
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas

# Moodle integration (LMS)
# Local compose URL:
# MOODLE_BASE_URL=http://localhost:8081
# MOODLE_TOKEN=<token from Moodle Manage tokens>
MOODLE_BASE_URL=http://localhost:8081
MOODLE_TOKEN=

# ---------------------------------------------------------------------------
# University OS — institution identity & US compliance (Syllabus/Compliance)
# These auto-populate syllabus templates and IPEDS/NCES reporting.
# ---------------------------------------------------------------------------
INSTITUTION_NAME=Atlas Online University
# NCES_ID=
# IPEDS_CODE=
# REGIONAL_ACCREDITOR=
# STATE_AUTHORIZATION_ID=
# FERPA_OFFICER_EMAIL=ferpa@atlas.edu
# TITLE_IX_COORDINATOR_EMAIL=titleix@atlas.edu
# ADA_COORDINATOR_EMAIL=ada@atlas.edu

# ---------------------------------------------------------------------------
# Connectors — all optional. Each degrades gracefully if its keys are unset
# (the app boots and runs without any of them). Set to activate the connector.
# ---------------------------------------------------------------------------
# Payments — Stripe (SIS billing/ledger reconciliation + webhook)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# CRM — HubSpot (optional contact sync; native CRM-lite is source of truth)
# HUBSPOT_ACCESS_TOKEN=

# HR / Payroll — Gusto (US) and/or Deel (global)
# GUSTO_ACCESS_TOKEN=
# GUSTO_COMPANY_ID=
# GUSTO_API_BASE_URL=https://api.gusto.com
# DEEL_API_TOKEN=
# DEEL_API_BASE_URL=https://api.letsdeel.com

# Accounting — QuickBooks Online (push invoices/payments to the GL)
# QBO_ACCESS_TOKEN=
# QBO_REALM_ID=
# QBO_API_BASE_URL=https://quickbooks.api.intuit.com
# QBO_MINOR_VERSION=70

# Optional: local demo video served at /v1/media/demo.mp4
# DEMO_VIDEO_PATH=
